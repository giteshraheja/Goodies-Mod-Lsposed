<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    package="dev.gitesh.sbmods"
    android:versionCode="54"
    android:versionName="3.26.1">

    <uses-sdk android:minSdkVersion="34" android:targetSdkVersion="35" />

    <!-- Only apps signed with this app's key can control the mod inside SystemUI. -->
    <permission
        android:name="dev.gitesh.sbmods.permission.CONTROL"
        android:protectionLevel="signature" />
    <uses-permission android:name="dev.gitesh.sbmods.permission.CONTROL" />
    <!-- Only used when "Start the helper when the phone starts" is switched on -->
    <uses-permission android:name="android.permission.RECEIVE_BOOT_COMPLETED" />

    <!-- App picker for the "open an app" tap action -->
    <queries>
        <intent>
            <action android:name="android.intent.action.MAIN" />
            <category android:name="android.intent.category.LAUNCHER" />
        </intent>
        <!-- root and module managers, for the setup guide's "Open" buttons -->
        <package android:name="me.weishu.kernelsu" />
        <package android:name="df.root" />
        <package android:name="com.topjohnwu.magisk" />
        <package android:name="org.lsposed.manager" />
        <package android:name="org.matrix.vector.manager" />
        <package android:name="io.github.lsposed.manager" />
    </queries>

    <application
        android:label="PulseBar"
        android:icon="@drawable/ic_launcher"
        android:allowBackup="false"
        android:theme="@android:style/Theme.DeviceDefault.DayNight">

        <meta-data android:name="xposedmodule" android:value="true" />
        <meta-data android:name="xposeddescription" android:value="PulseBar: arrange the status bar items by drag and drop (clock, date, temperature, battery, network speed, back button) and see memory, sleep, heat and speed at a glance in Overview, with one-tap tools to tune them" />
        <meta-data android:name="xposedminversion" android:value="93" />
        <meta-data android:name="xposedscope" android:resource="@array/xposed_scope" />

        <activity
            android:name=".ui.OnboardingActivity"
            android:exported="false"
            android:label="Setup guide" />

        <activity
            android:name=".ui.SettingsActivity"
            android:exported="true">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>

        <!-- One-off root jobs asked for by the status bar / launcher part. Only senders that could already write the old request
             setting (WRITE_SECURE_SETTINGS: system apps, shell, root) may ask; this app's own second step and alarm are let through as "same app". -->
        <receiver android:name=".JobReceiver" android:exported="true"
            android:permission="android.permission.WRITE_SECURE_SETTINGS" />

        <receiver android:name=".BackupReceiver" android:exported="false" />

        <receiver android:name=".BootReceiver" android:exported="true">
            <intent-filter>
                <action android:name="android.intent.action.BOOT_COMPLETED" />
            </intent-filter>
        </receiver>
    </application>
</manifest>
